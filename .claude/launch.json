{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-canvas",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "cv-api",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000,
      "env": { "ENABLED_MODULES": "design,cv", "INVITE_CODE": "dev-invite", "DB_PATH": "backend/cv-dev.sqlite3" }
    },
    {
      "name": "cv-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev", "--", "--port", "5174"],
      "port": 5174,
      "env": { "VITE_ENABLED_MODULES": "design,cv" }
    }
  ]
}

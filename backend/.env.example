# Optional. Copy to backend/.env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# Sign-up is invite only. Leave blank and the server makes a random code on first start (backend/invite_code.txt) and prints it once.
INVITE_CODE=

# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=

# SQLite path (Docker default is /data/data.sqlite3). Local uvicorn uses backend/data.sqlite3.
# DB_PATH=

# Litestream → Azure Blob (Docker / Container Apps only; leave off for local).
# When enabled, the entrypoint restores the DB from the container if missing, then
# replicates continuously. Use a single replica — Litestream is single-writer.
# LITESTREAM_ENABLED=0
# LITESTREAM_AZURE_ACCOUNT_NAME=
# LITESTREAM_AZURE_CONTAINER=
# LITESTREAM_AZURE_PATH=data.sqlite3
# Prefer Managed Identity on Azure; otherwise set the storage account key:
# LITESTREAM_AZURE_ACCOUNT_KEY=

# Modules to mount (comma list). Production stays "design" until a module is finished. The frontend build has its own
# VITE_ENABLED_MODULES (set at build time) with the same names. Dotted tokens are slice flags (not packages):
# e.g. interview.voice enables the mic/transcribe path; plain `interview` alone does not.
# interview.research enables web question research (see the research settings below).
# study enables flashcards; study.maps enables mind maps (needs study).
# ENABLED_MODULES=design,cv,interview,interview.voice,interview.research,study,study.maps

# Speech-to-text for interview voice (Slice 3d). OpenAI Whisper is the default; set STT_PROVIDER=local only when
# faster-whisper is installed on the server. Audio is transcribed in memory and never stored.
# STT_PROVIDER=openai
# WHISPER_MODEL=whisper-1
# STT_MODEL_SIZE=base
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8

# More AI providers. Users pick among the ones a key is set for (Settings > AI). Local providers need no key.
# LLM_PROVIDER=openai          # server default when a user has not chosen: openai | anthropic | lmstudio | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Limits: per-user monthly tokens (0 = none), per-file bytes, per-user file storage bytes, concurrent background jobs.
# MONTHLY_TOKEN_QUOTA=2000000
# MAX_FILE_BYTES=5242880
# FILES_QUOTA_BYTES=52428800
# JOB_CONCURRENCY=2

# Interview question research (Slice 3c). Enable with the interview.research flag in ENABLED_MODULES (and VITE_ENABLED_MODULES).
# Keys stay on the server. Tavily is tried first, Exa when Tavily is out of allowance or fails; with neither key, research is skipped.
TAVILY_API_KEY=
EXA_API_KEY=
# The app stops calling a provider at these monthly caps, set below the free allowance (Tavily 1,000 credits; Exa $10).
# TAVILY_MONTHLY_CAP=900
# EXA_MONTHLY_CAP_USD=9
# EXA_SEARCH_TYPE=auto            # auto ($0.007 a search) or lite ($0.004)
# RESEARCH_USER_RUNS_PER_MONTH=5  # searches one user may start a month; reading what is already stored is always free
# RESEARCH_STORE_SCOPE=shared     # shared: one store for everyone (public data only); user: one store per user
# RESEARCH_COOLDOWN_HOURS=24     # a role family or company that was just searched is not searched again for this long
# RESEARCH_MIN_ITEMS=12           # fresh questions a role family and level needs before search is skipped
# RESEARCH_COMPANY_MIN_ITEMS=4
# RESEARCH_QUESTION_DAYS=60       # how long a question counts as fresh
# RESEARCH_NOTE_DAYS=14           # how long a note about a company's culture or engineering counts as fresh
# RESEARCH_MAX_STEPS=8
# RESEARCH_STEP_TIMEOUT_S=45
# RESEARCH_TOTAL_TIMEOUT_S=180

# Document embeddings (interview reference docs, later study/research). Needs an embeddings-capable provider (OpenAI).
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536
# EMBED_CHUNK_CHARS=2000
# EMBED_CHUNK_OVERLAP=200

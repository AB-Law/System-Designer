# Optional. Copy to backend/.env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=

# Sign-up is invite only. Leave blank and the server makes a random code on first start (backend/invite_code.txt) and prints it once.
INVITE_CODE=

# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=

# SQLite path (Docker default is /data/data.sqlite3). Local uvicorn uses backend/data.sqlite3.
# DB_PATH=

# Litestream → Azure Blob (Docker / Container Apps only; leave off for local).
# When enabled, the entrypoint restores the DB from the container if missing, then
# replicates continuously. Use a single replica — Litestream is single-writer.
# LITESTREAM_ENABLED=0
# LITESTREAM_AZURE_ACCOUNT_NAME=
# LITESTREAM_AZURE_CONTAINER=
# LITESTREAM_AZURE_PATH=data.sqlite3
# Prefer Managed Identity on Azure; otherwise set the storage account key:
# LITESTREAM_AZURE_ACCOUNT_KEY=

# Modules to mount (comma list). Production stays "design" until a module is finished. The frontend build has its own
# VITE_ENABLED_MODULES (set at build time) with the same names.
# ENABLED_MODULES=design,cv

# More AI providers. Users pick among the ones a key is set for (Settings > AI). Local providers need no key.
# LLM_PROVIDER=openai          # server default when a user has not chosen: openai | anthropic | lmstudio | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Limits: per-user monthly tokens (0 = none), per-file bytes, per-user file storage bytes, concurrent background jobs.
# MONTHLY_TOKEN_QUOTA=2000000
# MAX_FILE_BYTES=5242880
# FILES_QUOTA_BYTES=52428800
# JOB_CONCURRENCY=2
